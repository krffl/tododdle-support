{
  "name": "@krffl/tododdle-support-react-native",
  "version": "1.0.0",
  "description": "React Native report sheet for ToDoddle Support.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krffl/tododdle-support.git",
    "directory": "packages/react-native"
  },
  "homepage": "https://github.com/krffl/tododdle-support/tree/main/packages/react-native#readme",
  "bugs": "https://github.com/krffl/tododdle-support/issues",
  "keywords": [
    "tododdle",
    "support",
    "bug-report",
    "feedback",
    "react-native"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@krffl/tododdle-support": "1.0.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72"
  }
}
